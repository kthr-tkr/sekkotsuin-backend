ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/sekkotsuin
# 本番では必ず変更: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-change-me-in-production
CORS_ORIGINS=http://localhost:3000
TIMEZONE=Asia/Tokyo
# アップロードファイル（署名画像・姿勢写真）の保存先
MEDIA_DIR=media
# AI: openai / fake（開発用の固定応答）/ disabled
AI_PROVIDER=fake
OPENAI_API_KEY=
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

# 患者向け画面のベース URL（通知のリンクに使う）
PUBLIC_APP_URL=http://localhost:3000
# メール: smtp / console（送らずにログだけ出す）/ disabled
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMS: twilio / console / disabled
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+81...
